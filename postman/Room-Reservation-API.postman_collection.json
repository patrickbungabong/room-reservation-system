{
  "info": { "name": "Room Reservation API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:5000/api" }, { "key": "token", "value": "" }],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Student\", \"email\": \"student@test.com\", \"password\": \"student123\", \"role\": \"student\"\n}" },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": "var j = pm.response.json(); if (j.token) pm.collectionVariables.set('token', j.token);" }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\", \"password\": \"admin123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Rooms",
      "item": [
        {
          "name": "Get All Rooms",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/rooms?page=1&limit=10"
          }
        },
        {
          "name": "Create Room (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Room X\", \"capacity\": 15, \"location\": \"Building 3\", \"description\": \"Test room\", \"isActive\": true\n}" },
            "url": "{{baseUrl}}/rooms"
          }
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "Get My Reservations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/reservations/my"
          }
        },
        {
          "name": "Create Reservation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"room\": \"ROOM_ID_HERE\", \"date\": \"2025-06-15\", \"startTime\": \"09:00\", \"endTime\": \"10:00\", \"purpose\": \"Study group\"\n}" },
            "url": "{{baseUrl}}/reservations"
          }
        },
        {
          "name": "Approve (Admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"adminComment\": \"Approved\"\n}" },
            "url": "{{baseUrl}}/reservations/RESERVATION_ID/approve"
          }
        }
      ]
    }
  ]
}
